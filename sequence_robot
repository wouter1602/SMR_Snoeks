# CAMERA HELPERS for the sequence runner
# ============================================================
def grab_fresh_frame(flush=FRAME_FLUSH_COUNT):
    """
    Pull a few frames from the pipeline so we get an up-to-date image
    after parts have moved or after the robot just disturbed the scene.
    Updates the global latest_color_image / latest_depth_image and also
    refreshes px_per_mm from any visible ArUco markers.
    Returns (color_bgr, depth_u16).
    """
    global latest_color_image, latest_depth_image
    last_color = last_depth = None
    for _ in range(max(1, flush)):
        frames = pipeline.wait_for_frames()
        aligned = align.process(frames)
        cf = aligned.get_color_frame()
        df = aligned.get_depth_frame()
        if not cf or not df:
            continue
        df = spatial.process(df)
        df = temporal.process(df)
        df = hole_filling.process(df)
        last_depth = np.asanyarray(df.as_depth_frame().get_data())
        last_color = np.asanyarray(cf.get_data())

    if last_color is not None:
        latest_color_image = last_color
        latest_depth_image = last_depth
        corners, ids, _ = detector.detectMarkers(last_color)
        update_px_per_mm_from_aruco(corners, ids)

    return last_color, last_depth

def operator_prompt(msg, allowed=("placed",)):
    """
    Blocking input prompt. Returns the literal lowercase word the operator
    typed (must be one of `allowed`, or 'skip'/'abort' which are always
    accepted).
    """
    extras = ("skip", "abort")
    while True:
        try:
            ans = input(f"   >>> {msg}: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return "abort"
        if ans in allowed or ans in extras:
            return ans
        print(f"       (type one of: {', '.join(list(allowed)+list(extras))})")

# ============================================================
# SEQUENCE RUNNER  — multi-pick + shake-the-plate retry
# ============================================================
def run_sequence(path=SEQUENCE_FILE):
    if not os.path.exists(path):
        print(f"[ERR] sequence file not found: {path}")
        return
    with open(path, "r") as f:
        items = json.load(f)
    if not isinstance(items, list) or not items:
        print(f"[ERR] sequence file empty or wrong format: {path}")
        return

    print("\n" + "█" * 78)
    print(f" RUNNING SEQUENCE: {path}  ({len(items)} item(s))")
    print("█" * 78)

    for step_idx, item in enumerate(items, 1):
        tray       = item.get("tray",        f"#{step_idx}")
        part_key   = item.get("part")
        drop_box   = item.get("drop_box_mm", [0.0, 0.0, DEFAULT_DROP_Z_MM])
        retries    = int(item.get("retries", 3))
        count      = int(item.get("count",   1))   # how many to pick from this tray
        approach_dz = float(item.get("approach_dz_mm", APPROACH_DZ_MM))
        retreat_dz  = float(item.get("retreat_dz_mm",  RETREAT_DZ_MM))

        print("\n" + "─" * 78)
        print(f" STEP {step_idx}/{len(items)}  tray={tray}  part={part_key}  "
              f"count={count}  retries={retries}")
        print("─" * 78)

        if part_key not in PARTS:
            print(f"  [ERR] unknown part '{part_key}' — skipping.")
            continue

        # 1) ask operator to place the tray
        print(f"   put tray {tray} on the plate")
        ans = operator_prompt("type 'placed' when ready (or 'skip'/'abort')")
        if ans == "abort":
            print("   ABORT requested — leaving sequence.")
            return
        if ans == "skip":
            print(f"   skipping tray {tray}.")
            continue

        # 2) pick `count` items from this tray
        picked = 0
        for pick_idx in range(1, count + 1):
            print(f"\n   ── PICK {pick_idx}/{count}  (tray {tray}, part {part_key}) ──")

            best = None
            for attempt in range(1, retries + 1):
                # Always take a FRESH picture — between picks the scene
                # has changed because we just removed an item.
                color, depth = grab_fresh_frame()
                if color is None:
                    print("   [ERR] no camera frame — aborting step.")
                    break

                result = detect_part(part_key, color, depth,
                                     save_annot=True, show=True)
                best = result["best"]
                if best is not None and best["world"] is not None:
                    break  # got a valid pick

                # ── nothing found → ask operator to shake the plate ──
                remaining = retries - attempt
                print(f"\n   ⚠️  Could not find a usable '{part_key}'.")
                if remaining <= 0:
                    print( "      No retries left for this pick.")
                    break
                print(f"      Please SHAKE the plate so parts reposition.")
                print(f"      ({remaining} retry/retries left)")
                ans = operator_prompt(
                    "type 'shaken' when done (or 'skip'/'abort')",
                    allowed=("shaken",))
                if ans == "abort":
                    print("   ABORT requested — leaving sequence.")
                    return
                if ans == "skip":
                    print("   skipping this pick.")
                    best = None
                    break
                # else: loop and retake picture

            if best is None or best["world"] is None:
                print(f"   ✗ giving up on pick {pick_idx}/{count} for tray {tray}.")
                # Move to next pick? If we couldn't find anything at all,
                # there is probably nothing left in the crate -> break out
                # of the count-loop instead of hammering the operator.
                break

            # 3) world -> robot
            p_robot, robot_yaw = world_to_robot(best["world"], best["yaw_deg"])
            xr, yr, zr = p_robot
            print(f"   ROBOT pick target : "
                  f"X={xr:7.2f} Y={yr:7.2f} Z={zr:7.2f}  yaw={robot_yaw:+.1f}°")

            # 4) motion sequence
            z_app    = zr + approach_dz   # +10 mm above pick
            z_retr   = zr + retreat_dz    # safe travel height

            print("   → approach")
            ROBOT.move_to(xr, yr, z_retr, robot_yaw, speed=200)
            ROBOT.move_to(xr, yr, z_app,  robot_yaw, speed=120)
            print("   → descend to pick")
            ROBOT.move_to(xr, yr, zr,     robot_yaw, speed=60)

            # 5) close gripper per PARTS dict
            ROBOT.close_gripper(best["gripper"])

            print("   → retreat")
            ROBOT.move_to(xr, yr, z_retr, robot_yaw, speed=120)

            # 6) move to drop box and release
            dx, dy, dz = drop_box
            print(f"   → drop box  X={dx:.1f}  Y={dy:.1f}  Z={dz:.1f}")
            ROBOT.move_to(dx, dy, max(dz, z_retr), robot_yaw, speed=200)
            ROBOT.move_to(dx, dy, dz,              robot_yaw, speed=100)
            ROBOT.open_gripper(best["gripper"])
            ROBOT.move_to(dx, dy, max(dz, z_retr), robot_yaw, speed=150)

            picked += 1
            print(f"   ✓ pick {pick_idx}/{count} done "
                  f"(total picked from tray {tray}: {picked})")

            # settle before next picture
            if pick_idx < count:
                time.sleep(POST_PICK_SETTLE_S)

        print(f"\n   Tray {tray} summary: {picked}/{count} picked.")

    ROBOT.home()
    print("\n" + "█" * 78)
    print(" SEQUENCE COMPLETE")
    print("█" * 78 + "\n")

