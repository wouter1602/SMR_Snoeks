                        cv2.FONT_HERSHEY_SIMPLEX, S_MED,
                        col_dot, T_THIN, cv2.LINE_AA)

        y0 = int(28 * UI_SCALE)
        p_name = PARTS[ACTIVE_PART]["name"]
        p_grip = PARTS[ACTIVE_PART]["gripper"]
        cv2.putText(img, f"Part: {p_name}  [gripper={p_grip}]  (X=detect  P=sequence)",
                    (10, y0), cv2.FONT_HERSHEY_SIMPLEX, S_BIG,
                    (0, 255, 255), T_BOLD, cv2.LINE_AA)
        y0 += LINE_H

        if current_px_per_mm is not None:
            cv2.putText(img, f"scale: {current_px_per_mm:.2f} px/mm",
                        (10, y0), cv2.FONT_HERSHEY_SIMPLEX, S_SMALL,
                        (200, 200, 200), T_THIN, cv2.LINE_AA)
            y0 += LINE_HS

        if cam_pos_world is not None:
            col = (0, 255, 0) if (fit_ok and z_ok) else (0, 0, 255)
            cv2.putText(img,
                        f"Cam: X={cam_pos_world[0]*100:5.1f} "
                        f"Y={cam_pos_world[1]*100:5.1f} "
                        f"Z={cam_pos_world[2]*100:5.1f} cm",
                        (10, y0), cv2.FONT_HERSHEY_SIMPLEX,
                        S_MED, col, T_THIN, cv2.LINE_AA)
            y0 += LINE_HS
            lock_label = "[LOCKED]" if calibration_locked else "[live]"
            cv2.putText(img,
                        f"Kabsch: {residual_m*1000:5.1f} mm  {lock_label}",
                        (10, y0), cv2.FONT_HERSHEY_SIMPLEX, S_SMALL,
                        (255, 0, 255) if calibration_locked else col,
                        T_THIN, cv2.LINE_AA)
            y0 += LINE_HS

        cv2.putText(img,
                    "L=click  SPACE=lock  S=save  D=load  X=detect  "
                    "P=sequence  1..9=part  ESC=stop",
                    (10, COLOR_H - int(12 * UI_SCALE)),
                    cv2.FONT_HERSHEY_SIMPLEX, S_SMALL,
                    (200, 200, 200), T_THIN, cv2.LINE_AA)

        cv2.imshow("World Calibration", img)
        key = cv2.waitKey(1) & 0xFF

        if key == 27:
            break
        elif key == 32:
            if calibration_locked:
                calibration_locked = False
                T_world_cam_locked = None
                print("UNLOCKED")
            elif T_world_cam is not None and fit_ok and z_ok:
                T_world_cam_locked = T_world_cam.copy()
                calibration_locked = True
                print(f"LOCKED (residual={residual_m*1000:.1f} mm)")
            else:
                print("Cannot lock yet.")
        elif key in (ord('c'), ord('C')):
            for mid in marker_history:
                marker_history[mid].clear()
        elif key in (ord('s'), ord('S')):
            T_to_save = T_world_cam_locked if calibration_locked else T_world_cam
            if T_to_save is not None:
                save_calibration(T_to_save, residual_m)
        elif key in (ord('d'), ord('D')):
            T_loaded = load_calibration()
            if T_loaded is not None:
                T_world_cam_locked = T_loaded
                calibration_locked = True
        elif key in (ord('x'), ord('X')):
            run_sam3_detect(latest_color_image.copy(), latest_depth_image)
        elif key in (ord('p'), ord('P')):
            run_sequence(SEQUENCE_FILE)
        elif ord('1') <= key <= ord('9'):
            idx = key - ord('1')
            if idx < len(PART_KEYS):
                ACTIVE_PART = PART_KEYS[idx]
                print(f"Active part -> {PARTS[ACTIVE_PART]['name']}")

finally:
    pipeline.stop()
    cv2.destroyAllWindows()
