# ============================================================
# WORLD <-> ROBOT TRANSFORM
# ============================================================
def _default_T_robot_world():
    T = np.eye(4)
    T[0, 0] = 1000.0
    T[1, 1] = 1000.0
    T[2, 2] = 1000.0
    return T

def load_robot_world_transform(path=ROBOT_CALIB_FILE):
    if not os.path.exists(path):
        print(f"[warn] {path} not found — using identity m->mm transform.")
        return _default_T_robot_world()
    with open(path, "r") as f:
        data = json.load(f)
    T = np.array(data["T_robot_world"], dtype=np.float64)
    print(f"[ok] Loaded robot/world transform from {path}")
    return T

T_ROBOT_WORLD = load_robot_world_transform()

def world_to_robot(world_xyz_m, world_yaw_deg=0.0):
    p_h = np.array([world_xyz_m[0], world_xyz_m[1], world_xyz_m[2], 1.0])
    p_robot = (T_ROBOT_WORLD @ p_h)[:3]
    R = T_ROBOT_WORLD[:3, :3].copy()
    for i in range(3):
        n = np.linalg.norm(R[:, i])
        if n > 1e-9:
            R[:, i] /= n
    yaw_offset_deg = np.degrees(np.arctan2(R[1, 0], R[0, 0]))
    robot_yaw = world_yaw_deg + yaw_offset_deg
    robot_yaw = ((robot_yaw + 180.0) % 360.0) - 180.0
    return p_robot, robot_yaw

